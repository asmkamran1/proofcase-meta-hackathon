# ProofCase model provider configuration.
# New installs default to META (native Meta Model API, muse-spark-1.3).
# Set MODEL_PROVIDER=BASETEN to use the legacy Baseten integration.
# Never commit real keys. Copy to .env.local and fill in.
# Note: process environment variables take precedence over .env.local values,
# so a stale exported variable can override the file. Unset stale values first.

MODEL_PROVIDER=META
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1

# Legacy Baseten options (only used when MODEL_PROVIDER=BASETEN):
# BASETEN_API_KEY=
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_MODEL=meta-models/muse-spark-open-1026
